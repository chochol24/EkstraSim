@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        EkstraSim
    </MudAppBar>
    <MudDrawer Open="true">
        <MudNavMenu>
            <MudNavLink Href="/teams">Drużyny</MudNavLink>
            <MudNavLink Href="/simulated-rounds">Symulowane rundy</MudNavLink>
            <MudNavLink Href="/season">Sezon</MudNavLink>
            <MudNavLink Href="/matches">Mecze</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/research">Badania</MudNavLink>
            <MudNavLink Href="/model-prediction">Predykcja kolejki</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <div style="padding:10px;">
            @Body
        </div> 
    </MudMainContent>
    <div class="footer">
        <MudText Typo="Typo.body2">Jakub Woźniak</MudText>
    </div>
</MudLayout>

@code {
	private MudTheme _theme = new();
	private bool _isDarkMode = true;
}