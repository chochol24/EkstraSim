@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        EkstraSim
    </MudAppBar>
    <MudDrawer Open="true">
        <MudNavMenu>
            <MudNavLink Href="/teams">Drużyny</MudNavLink>
            <MudNavLink Href="/simulated-rounds">Symulowane rundy</MudNavLink>
            <MudNavLink Href="/season">Sezon</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <div style="padding:10px;">
            @Body
        </div> 
    </MudMainContent>
</MudLayout>

@code {
	private MudTheme _theme = new();
	private bool _isDarkMode = true;
}