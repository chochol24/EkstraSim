@page "/teams"
@using EkstraSim.Frontend.Components.Services
@using EkstraSim.Shared.Resources
@using Shared.DTOs

@inject TeamService _teamService
@inject ISnackbar Snackbar
<h3>Teams</h3>

@if (teams == null)
{
    <p>Loading...</p>
}
else
{
    <MudDataGrid Items="@teams">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Nazwa" />
            <PropertyColumn Property="x => x.ELO" Title="Elo" />
        </Columns>
    </MudDataGrid>
}

@code {

    private List<TeamDTO>? teams;

    protected override async Task OnInitializedAsync()
    {
        var result = await _teamService.GetTeamsAsync();

        if (result.Data != null && result.Success == true)
        {
            teams = result.Data;
        }
        else
        {
            Snackbar.Add(SnackbarMessages.Teams_Get_Failed, Severity.Error);
        }
    }


}